# Template only. Put local secrets in ignored .env, never in source control.
# Copy to .env and fill real values; do NOT commit the real .env.

# ---- LLM / ASR (Alibaba Cloud Model Studio / DashScope) ----
DASHSCOPE_API_KEY=
SECRET_KEY=replace-with-a-long-random-value
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_NAME=qwen3.7-plus
QWEN_FALLBACK_MODEL_NAME=qwen3.8-flash
ASR_MODEL=qwen3-asr-flash
ASR_FALLBACK_MODEL=qwen-audio-3.1-asr-flash
# Explicit quota exhaustion switches to the fallback; network/auth failures do NOT.
# Empty fallback model disables that fallback.
# ASR_API_KEY=  # Optional separate ASR credential; empty reuses DASHSCOPE_API_KEY
# ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ASR_NATIVE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# ---- Local model caches (relative to backend root; adjust to a writable dir) ----
# BGE_MODEL_DIR=./models
# OCR_MODEL_DIR=./ocr_models
# SPEECH_TEMP_DIR=./speech_tmp
# FFMPEG_PATH=

# ---- Optional: QWeather (leave empty to disable weather feature) ----
# QWEATHER_API_KEY=
# QWEATHER_API_HOST=

# ---- Process ----
# RUN_SCHEDULER=1  # 1 = run in-process APScheduler; keep 1 for single-worker deploy
