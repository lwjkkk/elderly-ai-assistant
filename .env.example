# Template only. Put local secrets in ignored .env, never in source control.
DASHSCOPE_API_KEY=
SECRET_KEY=replace-with-a-long-random-value
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_NAME=qwen3.7-plus
QWEN_FALLBACK_MODEL_NAME=qwen3.8-flash
ASR_MODEL=qwen3-asr-flash
ASR_FALLBACK_MODEL=qwen-audio-3.1-asr-flash
# Enable free-tier-only for all four models in the Bailian console.
# Explicit quota exhaustion is cached per process for 24h (reset on restart).
# Empty fallback model disables that fallback. Network/auth failures do not switch.
# ASR_API_KEY=  # Optional separate key; empty uses DASHSCOPE_API_KEY
# ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ASR_NATIVE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# BGE_MODEL_DIR=D:/models
# OCR_MODEL_DIR=D:/ocr_models
# FFMPEG_PATH=D:/tools/ffmpeg.exe
# SPEECH_TEMP_DIR=D:/private/speech
