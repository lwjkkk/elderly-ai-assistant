{
  "info": {
    "name": "老年数字辅助智能体 - Day1 接口集合",
    "description": "注册老人 + 注册家属 + 输码绑定 三连跑通验证",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1-注册老人",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"13800000001\",\n  \"password\": \"123456\",\n  \"nickname\": \"张大爷\",\n  \"role\": \"elder\"\n}"
        },
        "url": { "raw": "http://localhost:8000/api/auth/register", "host": ["localhost"], "port": "8000", "path": ["api", "auth", "register"] }
      }
    },
    {
      "name": "2-注册家属",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"13800000002\",\n  \"password\": \"123456\",\n  \"nickname\": \"小明\",\n  \"role\": \"family\"\n}"
        },
        "url": { "raw": "http://localhost:8000/api/auth/register", "host": ["localhost"], "port": "8000", "path": ["api", "auth", "register"] }
      }
    },
    {
      "name": "3-老人登录",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var data = pm.response.json();",
              "pm.collectionVariables.set('elder_token', data.access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"13800000001\",\n  \"password\": \"123456\"\n}"
        },
        "url": { "raw": "http://localhost:8000/api/auth/login", "host": ["localhost"], "port": "8000", "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "4-家属登录",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var data = pm.response.json();",
              "pm.collectionVariables.set('family_token', data.access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"13800000002\",\n  \"password\": \"123456\"\n}"
        },
        "url": { "raw": "http://localhost:8000/api/auth/login", "host": ["localhost"], "port": "8000", "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "5-老人生成邀请码",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var data = pm.response.json();",
              "pm.collectionVariables.set('invite_code', data.invite_code);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{elder_token}}" }
        ],
        "url": { "raw": "http://localhost:8000/api/bind/invite", "host": ["localhost"], "port": "8000", "path": ["api", "bind", "invite"] }
      }
    },
    {
      "name": "6-家属接受绑定",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{family_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"invite_code\": \"{{invite_code}}\"\n}"
        },
        "url": { "raw": "http://localhost:8000/api/bind/accept", "host": ["localhost"], "port": "8000", "path": ["api", "bind", "accept"] }
      }
    },
    {
      "name": "7-查询绑定列表(老人)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{elder_token}}" }
        ],
        "url": { "raw": "http://localhost:8000/api/bind/list", "host": ["localhost"], "port": "8000", "path": ["api", "bind", "list"] }
      }
    },
    {
      "name": "8-查询绑定列表(家属)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{family_token}}" }
        ],
        "url": { "raw": "http://localhost:8000/api/bind/list", "host": ["localhost"], "port": "8000", "path": ["api", "bind", "list"] }
      }
    },
    {
      "name": "9-刷新Token",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{elder_token}}" }
        ],
        "url": { "raw": "http://localhost:8000/api/auth/refresh", "host": ["localhost"], "port": "8000", "path": ["api", "auth", "refresh"] }
      }
    }
  ],
  "variable": [
    { "key": "elder_token", "value": "" },
    { "key": "family_token", "value": "" },
    { "key": "invite_code", "value": "" }
  ]
}
